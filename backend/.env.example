# Backend production environment (El Renad)
NODE_ENV=production
PORT=10000

# On Render the service must bind all interfaces. Locally use 127.0.0.1.
HOST=0.0.0.0

# MongoDB Atlas connection string. The database name (`school`) is the path
# segment after the host — the NestJS app only honors the DB name in the URI.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.95lwiab.mongodb.net/school?retryWrites=true&w=majority
DB_NAME=school

# Security — generate a long random value (e.g. `openssl rand -base64 48`).
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRATION=7d

# CORS: comma-separated allowed origins. On Render the frontend and backend are
# separate origins, so this MUST include the deployed frontend URL.
# localhost:3000 / :3001 are always allowed automatically for local tooling.
CORS_ORIGIN=https://<your-frontend-service>.onrender.com

# Uploads folder. NOTE: Render's filesystem is ephemeral — uploaded files are
# lost on redeploy/restart unless a Render Disk (paid) or external object
# storage is attached. See RENDER_DEPLOY.md.
UPLOAD_DIR=./uploads

# Mail settings (required for verification-code and password-reset emails).
# Gmail SMTP via nodemailer's "gmail" service — MAIL_USER is a full Gmail/
# Workspace address and MAIL_PASS a 16-character Google App Password.
MAIL_USER=
MAIL_PASS=

# Optional — display name shown as the email sender. Defaults to "El Renad".
MAIL_FROM_NAME=El Renad

# Optional — Reply-To address for outgoing mail. Defaults to MAIL_USER.
MAIL_REPLY_TO=
