# Frontend production environment (School)
NODE_ENV=production

# Public app URL (used in reset-password links). Your deployed frontend URL.
NEXT_PUBLIC_APP_URL=https://<your-frontend-service>.onrender.com

# Backend API URL and origin. On Render the backend is a SEPARATE service/origin,
# so these must be the absolute backend URL (NOT a same-origin /api path).
# NEXT_PUBLIC_* values are inlined at BUILD time — after changing them on Render
# you must trigger a frontend rebuild.
NEXT_PUBLIC_API_BASE_URL=https://<your-backend-service>.onrender.com/api
NEXT_PUBLIC_BACKEND_ORIGIN=https://<your-backend-service>.onrender.com

# Optional
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_CURRENCY=EGP
