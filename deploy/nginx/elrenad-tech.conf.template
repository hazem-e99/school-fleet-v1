# elrenad.tech (School Fleet) - Nginx reverse proxy
# Regenerated by deploy/deploy.sh on every run from this template until a
# certificate exists (certbot then appends its own SSL server blocks below
# on first successful issuance; those ARE preserved since deploy.sh only
# overwrites this file before SSL is configured, never after).
#
# This is a completely separate Nginx site file from el-renad.com's own
# config — it is never edited by this template, and this template never
# touches /etc/nginx/sites-available/el-renad or /etc/nginx/sites-enabled/el-renad.

map $http_upgrade $connection_upgrade_elrenadtech {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name @@DOMAIN_WWW@@;
    return 301 $scheme://@@DOMAIN_PRIMARY@@$request_uri;
}

server {
    listen 80;
    listen [::]:80;
    server_name @@DOMAIN_PRIMARY@@;

    client_max_body_size 25m;

    # Never serve dotfiles (.env, .git, etc.)
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;
    gzip_min_length 1024;

    # Next.js's own image proxy route (frontend/src/app/api/image-proxy) —
    # more specific than the /api/ block below, so nginx's longest-prefix
    # match routes it to the frontend instead of the backend even though it
    # also lives under /api/.
    location /api/image-proxy {
        proxy_pass http://127.0.0.1:@@FRONTEND_PORT@@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Backend REST API (also serves uploaded files via GET /api/files/:id —
    # profile pictures are stored in MongoDB GridFS, not on local disk).
    location /api/ {
        proxy_pass http://127.0.0.1:@@BACKEND_PORT@@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # Socket.IO - live bus tracking (WebSocket upgrade)
    location /socket.io/ {
        proxy_pass http://127.0.0.1:@@BACKEND_PORT@@;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade_elrenadtech;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }

    # Everything else - the Next.js app
    location / {
        proxy_pass http://127.0.0.1:@@FRONTEND_PORT@@;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade_elrenadtech;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
